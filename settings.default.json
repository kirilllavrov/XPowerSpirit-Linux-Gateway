{
  "subscription": {
    "url": "",
    "user_agent": "XPower/1.2",
    "remarks": ""
  },
  "hwid": "",
  "device_model": "",
  "device_os": "",
  "ver_os": "",
  "network": {
    "interface": "",
    "ip": "",
    "mask": "255.255.255.0",
    "gateway": ""
  },
  "xray": {
    "gid": 990,
    "tproxy_port": 12345,
    "dns_in_port": 15353,
    "tproxy_mark": 1,
    "bypass_mark": 2,
    "tcp_keepalive_interval": 30,
    "direct_domain_strategy": "UseIPv4"
  },
  "log": {
    "loglevel": "none",
    "access": "/var/log/xray-access.log",
    "error": "/var/log/xray-error.log"
  },
  "api": {
    "enabled": true,
    "listen_port": 10085
  },
  "dns": {
    "query_strategy": "UseIPv4",
    "disable_cache": false,
    "serve_stale": true,
    "serve_expired_ttl": 1800,
    "disable_fallback": false,
    "disable_fallback_if_match": true,
    "enable_parallel_query": true,
    "dnsmasq_fallback": "77.88.8.8",
    "hosts": {
      "common.dot.dns.yandex.net": [
        "77.88.8.1",
        "77.88.8.8"
      ],
      "cloudflare-dns.com": [
        "1.0.0.1",
        "1.1.1.1"
      ],
      "doh.ffmuc.net": [
        "5.1.66.255",
        "185.150.99.255"
      ],
      "unfiltered.adguard-dns.com": [
        "94.140.14.140",
        "94.140.14.141"
      ],
      "dns.quad9.net": [
        "9.9.9.9",
        "149.112.112.112"
      ]
    },
    "servers": [
      {
        "address": "https+local://common.dot.dns.yandex.net/dns-query",
        "domains": [
          "domain:ru",
          "domain:su",
          "domain:xn--p1ai",
          "domain:рф",
          "geosite:category-ru"
        ],
        "expectedIPs": [
          "geoip:ru",
          "*"
        ],
        "skipFallback": true
      },
      {
        "address": "https+local://cloudflare-dns.com/dns-query",
        "skipFallback": false
      },
      {
        "address": "quic+local://dns.quad9.net",
        "skipFallback": false
      },
      {
        "address": "https+local://unfiltered.adguard-dns.com/dns-query",
        "skipFallback": false
      },
      {
        "address": "https+local://doh.ffmuc.net/dns-query",
        "skipFallback": false
      }
    ],
    "block_via_dns": true,
    "block_rcode": 3,
    "block_domains": [
      "geosite:category-ads"
    ]
  },
  "balancer": {
    "expected": 2,
    "max_rtt": "800ms",
    "baselines": [
      "200ms"
    ],
    "streaming": {
      "enabled": true,
      "strategy": "leastPing"
    },
    "fallback_tag": "direct"
  },
  "observatory": {
    "destination": "https://connectivitycheck.gstatic.com/generate_204",
    "interval": "1m",
    "sampling": 10,
    "timeout": "15s",
    "http_method": "GET"
  },
  "geodata": {
    "dir": "/usr/local/share/xray",
    "geoip_url": "https://storage.yandexcloud.net/xpower/GEO/geoip.dat",
    "geosite_url": "https://storage.yandexcloud.net/xpower/GEO/geosite.dat"
  },
  "routing": {
    "domain_strategy": "IPOnDemand",
    "direct": {
      "domains": [
        "geosite:private",
        "geosite:category-browser",
        "geosite:category-cdn-ru",
        "geosite:category-mobile",
        "geosite:category-ru"
      ],
      "ips": [
        "geoip:ru",
        "geoip:private"
      ],
      "bittorrent": true
    },
    "block": {
      "domains": []
    },
    "proxy": {
      "domains": [
        "geosite:category-streaming",
        "geosite:category-games",
        "geosite:category-ipcheck"
      ]
    },
    "doh_bypass": [
      "common.dot.dns.yandex.net",
      "cloudflare-dns.com",
      "dns.google",
      "dns.quad9.net",
      "doh.opendns.com",
      "unfiltered.adguard-dns.com",
      "doh.ffmuc.net"
    ]
  }
}
