#!/bin/bash
# XPowerSpirit Gateway CLI — управление прозрачным шлюзом Xray (TProxy)
#
# Использование:
#   xpower status            Показать состояние шлюза
#   xpower start|stop|restart|toggle
#   xpower update            Обновить Xray, geo, подписку и конфиг
#   xpower test              Проверить интернет, DNS, TProxy и маршрутизацию
#   xpower traffic           Статистика трафика по серверам
#   xpower logs              Логи Xray в реальном времени
#   xpower config            Показать config.json
#   xpower proxy-list        Список прокси-серверов из config.json
#   xpower profile [ФИЛЬТР]  Показать или сменить профиль подписки
#   xpower setup             Переприменить правила nftables
#   xpower version           Версии CLI и Xray
#
# Каталог конфигурации можно переопределить: XPOWER_CONFIG_DIR=/etc/xray

set -uo pipefail

XPOWER_VERSION="1.0"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

CONFIG_DIR="${XPOWER_CONFIG_DIR:-/etc/xray}"
CONFIG_JSON="${CONFIG_DIR}/config.json"
SETTINGS_JSON="${CONFIG_DIR}/settings.json"
# Состояние подписки (режим, причина DIRECT-режима, профиль) — пишет генератор
STATUS_JSON="${CONFIG_DIR}/state/status.json"

XRAY_BIN="${XPOWER_XRAY_BIN:-/usr/local/bin/xray}"
UPDATE_SCRIPT="${XPOWER_UPDATE_SCRIPT:-/usr/local/share/xray/update-xray.sh}"
NFT_SCRIPT="${XPOWER_NFT_SCRIPT:-/usr/local/share/xray/update-nft.sh}"
SERVICE="${XPOWER_SERVICE:-xray}"

usage() {
	cat <<EOF
XPowerSpirit Gateway — управление прозрачным шлюзом Xray

Использование:
  xpower <команда> [аргументы]
  xpower help <команда>    подробная справка по одной команде

Состояние:
  xpower status            Состояние шлюза (сервис, nftables, DNS, подписка, трафик)
  xpower test              Проверки: интернет, DNS, TProxy, маршрутизация
  xpower traffic           Трафик по серверам (через API Xray)
  xpower version           Версии CLI и Xray

Управление сервисом (нужен root):
  xpower start             Запустить Xray
  xpower stop              Остановить Xray
  xpower restart           Перезапустить Xray
  xpower toggle            Включить/выключить Xray

Обновление и правила (нужен root):
  xpower update            Обновить Xray, geo, подписку и config.json
  xpower setup             Переприменить правила nftables

Настройка и диагностика:
  xpower profile [ФИЛЬТР]  Показать профиль подписки или переключить на другой
  xpower config            Показать config.json
  xpower proxy-list        Список прокси-серверов
  xpower logs              Логи Xray в реальном времени (нужен root)

Справка:
  xpower help              Эта справка
  xpower help <команда>    Подробно: что делает команда, от чего зависит, примеры

То же, что xpower help <команда>: xpower --help, xpower -h,
xpower <команда> --help и xpower <команда> -h.
EOF
}

# Подробная справка по одной команде: xpower help status
# Та же справка доступна как xpower status --help
